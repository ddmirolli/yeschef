{
  "name": "@yeschef/site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "npm run check && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test tests/*.test.ts",
    "test:browser": "node scripts/verify-browser.ts",
    "deploy": "npm run build && wrangler deploy --config ../deploy/yeschef/wrangler.jsonc",
    "demo:generate": "cd .. && node site/scripts/generate-demo.ts"
  },
  "dependencies": {
    "astro": "7.4.10"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "^24.0.0",
    "esbuild": "^0.27.0",
    "typescript": "~6.0.3",
    "wrangler": "^4.0.0",
    "playwright-core": "^1.56.0",
    "pngjs": "^7.0.0",
    "@types/pngjs": "^6.0.0"
  }
}
