---
import generatedPage from '../../../demo/team.html?raw';
import { inlineScript } from '../../scripts/inline';

// The team demo (Dan, 2026-11-12): the app itself with a made-up team below you (client/demo-team.ts), in Your team.
// The application owns this generated snapshot. The site owns its isolated bootstrap, shared with the solo demo.
const head = generatedPage.match(/<head>([\s\S]*?)<\/head>/)?.[1]
  ?.replace(/<script type="importmap">[\s\S]*?<\/script>/, '')
  .replace('<script src="shim.js"></script>', '');
const body = generatedPage.match(/<body[^>]*>([\s\S]*?)<\/body>/)?.[1]
  ?.replace('<script type="module" src="boot.mjs"></script>', '');
if (!head || !body) throw new Error('Regenerate the team demo before building the site.');
const shim = inlineScript('src/demo/shim.ts');
---
<!doctype html>
<html lang="en" data-team="open">
  <head>
    <script is:inline set:html={shim}></script>
    <!-- After the shim, which gives the page its own storage: the demo opens on Your team. -->
    <script is:inline>localStorage.setItem('yc.scope', 'team');</script>
    <Fragment set:html={head} />
  </head>
  <body class="pass-app">
    <Fragment set:html={body} />
    <script>import '../../demo/boot';</script>
  </body>
</html>
