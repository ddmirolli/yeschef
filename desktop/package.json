{
  "name": "yeschef-desktop",
  "productName": "Yes Chef",
  "private": true,
  "version": "0.1.0",
  "description": "Yes Chef for the desktop: The Pass, signed in to the T3 Code on this machine.",
  "type": "module",
  "main": "main.ts",
  "scripts": {
    "start": "node build/preload.ts && electron .",
    "capture": "node build/preload.ts && electron . --capture",
    "app": "node build/package.ts",
    "dist": "node build/package.ts --dist",
    "check": "node build/check.ts",
    "release": "zsh build/release.zsh",
    "typecheck": "effect-tsgo tsrs --noEmit",
    "test": "vp test run --config ../vite.config.ts --dir ."
  },
  "devDependencies": {
    "@electron/fuses": "1.8.0",
    "@types/node": "catalog:",
    "electron": "45.2.3",
    "electron-builder": "26.16.1"
  },
  "dependencies": {
    "effect": "catalog:",
    "electron-updater": "6.8.9"
  }
}
