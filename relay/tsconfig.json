{
  "extends": "../tsconfig.base.json",
  // As T3 Code's relay (infra/relay/tsconfig.json): Workers types, and Node's for the tests and the smoke test.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "WebWorker"],
    "types": ["@cloudflare/workers-types", "node"],
    // Not on Effect yet: Date, timers, console, fetch and crypto stay, as T3 Code's apps/web does. What the relay reads
    // crosses Schemas (messages.ts), but the room keeps its own clock, timers and crypto, so every file stays here.
    "plugins": [
      {
        "name": "@effect/language-service",
        "overrides": [
          {
            "include": ["**/*.ts", "../client/*.ts"],
            "options": { "diagnosticSeverity": { "globalDate": "off", "globalConsole": "off", "globalTimers": "off", "globalFetch": "off", "globalRandom": "off", "nodeBuiltinImport": "off", "cryptoRandomUUID": "off" } }
          }
        ]
      }
    ]
  },
  "include": ["*.ts", "../client/seal.ts"]
}
